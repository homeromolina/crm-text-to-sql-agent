# 100% open source por padrão: modelo local no Ollama + Langfuse self-hosted (docker compose up -d).

# Modelo (qualquer provedor do init_chat_model). Padrão: ollama pull qwen2.5:7b
LLM_MODEL=ollama:qwen2.5:7b
# Para usar um modelo de API: LLM_MODEL=anthropic:claude-sonnet-5-5 e pip install langchain-anthropic
# ANTHROPIC_API_KEY=

# Opcional: embeddings de verdade em vez dos locais (ex.: ollama:nomic-embed-text)
EMBEDDINGS_MODEL=

# Langfuse local (docker-compose.yml). As chaves abaixo já são criadas no primeiro "docker compose up",
# então os traces funcionam sem passar pela tela de cadastro. Troque tudo se for expor fora da sua máquina.
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-local-crm
LANGFUSE_SECRET_KEY=sk-lf-local-crm
LANGFUSE_INIT_ORG_ID=local
LANGFUSE_INIT_ORG_NAME=Local
LANGFUSE_INIT_PROJECT_ID=crm-agent
LANGFUSE_INIT_PROJECT_NAME=CRM text-to-SQL
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-local-crm
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-local-crm
LANGFUSE_INIT_USER_EMAIL=admin@local.test
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=troque-esta-senha
TELEMETRY_ENABLED=false

# Guardrails
MAX_TENTATIVAS=3
MAX_LINHAS=200
TIMEOUT_SEGUNDOS=5
