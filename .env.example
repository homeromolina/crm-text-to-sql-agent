# Modelo (qualquer provedor do init_chat_model). Instale o pacote do provedor escolhido.
LLM_MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Opcional: embeddings de verdade em vez dos locais (ex.: openai:text-embedding-3-small)
EMBEDDINGS_MODEL=

# Opcional: Langfuse (cloud.langfuse.com ou self-hosted). Sem as chaves, fica desligado.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Guardrails
MAX_TENTATIVAS=3
MAX_LINHAS=200
TIMEOUT_SEGUNDOS=5
